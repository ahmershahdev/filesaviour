# Copy to .env (Django/Celery) and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=filesaviour.ahmershah.dev
CSRF_TRUSTED_ORIGINS=https://filesaviour.ahmershah.dev
SITE_URL=https://filesaviour.ahmershah.dev
SUPPORT_EMAIL=support@ahmershah.dev
POSTGRES_PASSWORD=change-me
# Shared secret between Django and the engine (same value in .env.engine)
ENGINE_TOKEN=change-me-long-random
DJANGO_ADMIN_PATH=pick-an-unguessable-path/
FILE_TTL_MINUTES=60
MAX_UPLOAD_MB_ANON=50
MAX_UPLOAD_MB_USER=200
INERTIA_SSR_ENABLED=true
# Outgoing mail (password resets, contact form). Unset = printed to the console.
EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=FileSaviour <no-reply@ahmershah.dev>
